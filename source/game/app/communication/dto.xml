<?xml version="1.0" encoding="utf-8" standalone="yes" ?>
<protocols>
	<!--
	数据基本类型：string int byte ubyte short ushort uint float double
	-->
	
	<!-- 传输对象 -->
	<dto name="ResponseSuccess" desc="缺省返回成功">
		<item name="result" type="int" isArray = "false" />
	</dto>
	
	<dto name="ResponseFailed" desc="缺省返回成功">
		<item name="result" type="int" isArray = "false" />
	</dto>
	  
	<!-- 请求登录 -->
	<dto name="RequestLogin" desc="请求登录">
		<item name="username" type="string" isArray = "false" />
		<item name="password" type="string" isArray = "false" />
	</dto>
	
	<!-- 请求pvp列表，【进入大厅】 -->
	<dto name="RequestPVPList" desc="请求pvp列表，【进入大厅】" >
	</dto>
	
	<!-- 玩家信息 -->
	<dto name="PlayerInfo" desc="玩家信息" >
	</dto>
	
	<!-- 获取 pvp list -->
	<dto name="ResponsePVPListSuccess" desc="获取 pvp list" >
	   <item name="list" type="PlayerInfo" isArray="true" />
	</dto>
	
	<!-- 请求撮合 -->
	<dto name="RequestFightMatch" desc="请求撮合" >
	</dto>
	
	<!-- 撮合成功 -->
	<dto name="ResponseMatchSuccess" desc="撮合成功" >
	    <!-- 双方信息 -->
	</dto>
	
	<!-- 请求战斗已准备 -->
	<dto name="RequestFightReady" desc="请求战斗已准备" >
	</dto>
	
	<!-- 战斗开始【服务器推送】 -->
	<dto name="ResponseFightStartSuccess" desc="战斗开始【服务器推送】" >
	</dto>
	
	
	<!-- 请求出兵 -->
	<dto name="RequestTrain" desc="请求出兵">
	    <item name="npcId" type="int" isArray="false" />
	</dto>
	
	<!-- 出兵成功 -->
	<dto name="ResponseTrainSuccess" desc="出兵成功">
	    <item name="uid" type="int" isArray="false" desc="用户编号" />
	    <item name="npcId" type="int" isArray="false" desc="npc编号" />
	</dto>
	
	
	<!-- 请求发送战斗结果 -->
	<dto name="RequestSendFightResult" desc="" >
	    <item name="result" type="int" isArray="false" />
	</dto>
	
	<!-- 请求发送战斗结果，成功-->
	<dto name="ResponseSendFightResultSuccess" >
	    <item name="result" type="int" isArray="false" />
	</dto>
	
	<!-- 请求战斗结果 [服务器推送] -->
	<dto name="RequestFightResult" desc="请求战斗结果 [服务器推送]" >
	</dto> 
	
	<!-- 请求战斗结果，成功, [服务器推送] -->
	<dto name="ResponseFightResultSuccess" >
	</dto>
	
	
	<!-- 请求登录 -->
	<protocol name="REQUEST_LOGIN" dto="RequestLogin"  />
	<protocol name="RESPONSE_LOGIN_SUCCESS" dto="ResponseSuccess" />
	<protocol name="RESPONSE_LOGIN_FAILED" dto="ResponseFailed" />

    <!-- 请求pvp列表 -->
    <protocol name="REQUEST_PVP_LIST" dto="RequestPVPList" />
    <protocol name="RESPONSE_PVP_LIST_SUCCESS" dto="ResponsePVPListSuccess" />
    <protocol name="RESPONSE_PVP_LIST_FAILED" dto="ResponseFailed" />
    
    <!-- 请求撮合 -->
    <protocol name="REQUEST_FIGHT_MATCH" dto="RequestFightMatch" />
    <protocol name="RESPONSE_FIGHT_MATCH_SUCCESS" dto="ResponseMatchSuccess" />
    <protocol name="RESPONSE_FIGHT_MATCH_FAILED" dto="ResponseFailed" />
    
    <!-- 请求战斗已准备 -->
	<protocol name="REQUEST_FIGHT_READY" dto="RequestFightReady" />
	<protocol name="RESPONSE_FIGHT_READY_SUCCESS" dto="ResponseFightStartSuccess" />
	<protocol name="RESPONSE_FIGHT_READY_FAILED" dto="ResponseFailed" />
	
	<!-- 战斗开始【服务器推送】 -->
	<protocol name="RESPONSE_FIGHT_START_SUCCESS" dto="ResponseFightStartSuccess" />
	<protocol name="RESPONSE_FIGHT_START_FAILED" dto="ResponseFailed" />
    
    <!-- 请求出兵 -->
    <protocol name="REQUEST_TRAIN" dto="RequestTrain" />
    <protocol name="RESPONSE_TRAIN_SUCCESS" dto="ResponseTrainSuccess" />
    <protocol name="RESPONSE_TRAIN_FAILED" dto="ResponseFailed" />
    
    <!-- 请求发送战斗结果 -->
    <protocol name="REQUEST_SEND_FIGHT_RESULT" dto="RequestSendFightResult" />
    <protocol name="RESPONSE_SEND_FIGHT_RESULT_SUCCESS" dto="ResponseFightResultSuccess" />
    <protocol name="RESPONSE_SEND_FIGHT_RESULT_FAILED" dto="ResponseFailed" />

    <!-- 请求战斗结果 -->
    <protocol name="REQUEST_FIGHT_RESULT" dto="RequestFightResult" />
    <protocol name="RESPONSE_FIGHT_RESULT_SUCCESS" dto="ResponseFightResultSuccess" />
    <protocol name="RESPONSE_FIGHT_RESULT_FAILED" dto="ResponseFailed" />

	
</protocols>