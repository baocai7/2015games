        dump(event)

        local errorCode = checknumber(event.errorCode)
        if not(self and self.class and self.class.__cname == DYClass) then
            print("nil class : " .. DYClass)
            return
        else 
            local content = event.contents or {}
            local users = event.users or {}
            -- local str   = string.format(DY_KEY.kPrivateChatMsg, 
            --     tostring(CloudData.USER_SERVER_ID),
            --     tostring(event.sender),tostring(CloudData.UID))            
            -- DYStat.setValueStr(str,"")

            -- DYNotification.postNotification(DY_KEY.kFriendDelete, checknumber(event.sender))
        end       
    end
    -- SocketChatMgr:addRequestListener(2021, tFuncEvent)

    SocketChatMgr:regOnceRequest(2056,2057,{uid = CloudData.UID},
        function(event) tFuncEvent(event) end)
end

return M