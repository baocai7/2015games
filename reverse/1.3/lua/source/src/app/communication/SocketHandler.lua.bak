-- 接收好友变动消息
function M:addFriendDelListener()
    local function tFuncEvent(event)
        dump(event)

        local errorCode = checknumber(event.errorCode)
        if not(self and self.class and self.class.__cname == DYClass) then
            return
        elseif errorCode ~= 0 then
            local msg = event.errorMsg or "UNKNOWN"
            local toast = WSToast.new(msg, 2)
            self:addChild(toast,20)
            return
        else 
            local str   = string.format(DY_KEY.kPrivateChatMsg, tostring(CloudData.USER_SERVER_ID),tostring(event.sender),tostring(CloudData.UID))            
            DYStat.setValueStr(str,"")

            DYNotification.postNotification(DY_KEY.kFriendDelete, checknumber(event.sender))
        end       
    end
    SocketChatMgr:addRequestListener(2021, tFuncEvent)
end

-- 接收离线消息
